#!/bin/sh
# GhostWhisper post-install: everything the virtual keyboard needs except the
# one thing a package cannot do for you - put your user in the group.
set -e

if [ "$1" = "configure" ]; then
    if ! getent group uinput >/dev/null; then
        groupadd --system uinput
    fi

    modprobe uinput 2>/dev/null || true
    if [ -d /etc/modules-load.d ]; then
        echo uinput > /etc/modules-load.d/ghostwhisper-uinput.conf
    fi

    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --name-match=uinput || true
    fi

    printf '\n%s\n\n    %s\n\n%s\n\n' \
      "GhostWhisper: one step left so dictation can type into your windows:" \
      "sudo usermod -aG uinput \$USER" \
      "then log out and back in. After that: add the applet to the panel (Settings > Desktop > Panel), click its icon to download the speech model, and bind a custom keyboard shortcut to:  ghostwhisper --toggle"
fi

exit 0
